{
  "name": "@wxwzl/vue-virtual-scroller",
  "version": "0.1.0",
  "description": "Lightweight index-based virtual scroller for Vue 3",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./style": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vue",
    "vue3",
    "scroller",
    "virtual-scroll",
    "virtual-scroller",
    "component"
  ],
  "author": "wxwzl",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wxwzl/vue-virtual-tree.git"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "type-check": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.8.4",
    "typescript": "~5.3.3",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.6.0",
    "vue": "3.4.0",
    "vue-tsc": "^1.8.27"
  }
}
